# AV Tool — пример конфигурации секретов.
# Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env && chmod 600 .env
# Файл .env в .gitignore — реальные пароли не попадут в git.

# --- Веб-доступ: логин (email) и пароль для формы входа ---
AV_WEB_USER=admin@example.com
AV_WEB_PASS=change-me-long-random
# Разрешённые IP через запятую (пусто = любые)
AV_WEB_ALLOWED_IPS=

# --- База данных (для бэкапа/восстановления БД) ---
AV_DB_HOST=localhost
AV_DB_PORT=3306
AV_DB_USER=your_db_user
AV_DB_PASSWORD=change-me-too
AV_DB_NAME=your_db_name

# --- Домен сайта для привязки лицензии ---
# Должен совпадать с доменом, на который выдан ключ (без www и схемы).
# Для CLI-запусков обязателен, из веба берётся из HTTP_HOST автоматически.
AV_LICENSE_DOMAIN=example.com